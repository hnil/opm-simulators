-- The jump across the region boundary grows a bar per layer, so the largest
-- one, and hence the defaulted threshold, lies in the bottom layer -- seven
-- layers below anything the sector contains.
PRESSURE
  5*300.0 5*301.0
  5*300.0 5*302.0
  5*300.0 5*303.0
  5*300.0 5*304.0
  5*300.0 5*305.0
  5*300.0 5*306.0
  5*300.0 5*307.0
  5*300.0 5*308.0
  5*300.0 5*309.0
  5*300.0 5*310.0 /

-- Defaulted, which is the case that matters: an explicit number is in the deck
-- and both runs would read the same one.
THPRES
  1 2 1* /
/

SUMMARY

-- Sector cells on either side of the region boundary, and one against the
-- sector's edge, where the boundary is imposed.
BPR
  4 1 1 /
  6 1 2 /
  7 1 3 /
/

SCHEDULE

-- Restarts, so make_flux can build the same file from this run's output.
RPTRST
  'BASIC=2' /

TSTEP
  1 /

END

-- The sector of TWOWELL_CUTOUT_PARENT_1D, cells 3 to 5, as a grid of its
-- own, with only the well it holds. P2 and I1 are not in this deck at all, and
-- neither is I1's group, yet G1's target, the field and group totals and the
-- UDQs over P2 have to come out as in the parent.

RUNSPEC

TITLE
  Wells outside a cut-out sector: sector /

DIMENS
  3 1 1 /

OIL
WATER
GAS

METRIC

START
  1 JAN 2020 /

TABDIMS
  1 1 20 20 1 20 20 1 1 1 1 1 1 1 1 /

WELLDIMS
  3 2 3 3 /

UDQDIMS
  10*10 /

UNIFOUT

GRID

DXV
  3*100 /

DYV
  1*100 /

DZV
  1*10 /

TOPS
  3*2000 /

PORO
  3*0.25 /

PERMX
  3*1500 /

PERMY
  3*1500 /

PERMZ
  3*150 /

FLUXNUM
  3*1 /

FLUXREG
  1 /

FLUXTYPE
  PRESSURE /

USEFLUX
  'TWOWELL_CUTOUT_PARENT_1D' /


PROPS

DENSITY
  800 1000 1.2 /

PVTW
  250.0 1.03 3.0E-5 0.30 /

PVDO
  200.0 1.20 0.90
  300.0 1.10 1.00
  400.0 1.03 1.10 /

PVDG
  20.0 0.012 0.020
  50.0 0.006 0.030
  100.0 0.003 0.050
  200.0 0.0015 0.080 /

SWOF
  0.10 0.00 1.00 0.00
  0.20 0.05 0.70 0.00
  0.40 0.30 0.30 0.00
  0.60 0.70 0.05 0.00
  0.80 1.00 0.00 0.00 /

SGOF
  0.00 0.00 1.00 0.00
  0.05 0.02 0.80 0.00
  0.20 0.20 0.30 0.00
  0.40 0.70 0.05 0.00
  0.70 1.00 0.00 0.00 /

REGIONS

-- Region 1 straddles the sector's edge, region 2 lies wholly outside it.
FIPNUM
  3*1 /

SOLUTION

PRESSURE
  3*300 /

SWAT
  3*0.20 /

SGAS
  3*0.00 /

SUMMARY

ALL
FU_P2
FU_WSUM
FU_BHP2
FU_BP4P2
FU_RPR1
FU_ROPR2
FU_FPR

SCHEDULE
UDQ
  DEFINE FU_P2 WOPR 'P2' * 2 /
  DEFINE FU_WSUM SUM(WOPR '*') /
  DEFINE FU_BHP2 WBHP 'P2' /
  DEFINE FU_BP4P2 WBP4 'P2' /
  DEFINE FU_RPR1 RPR 1 /
  DEFINE FU_ROPR2 ROPR 2 /
  DEFINE FU_FPR FPR /
/

GRUPTREE
  'G1' 'FIELD' /
 /

WELSPECS
  'P1' 'G1' 2 1 1* 'OIL' /
 /

COMPDAT
  'P1' 2 1 1 1 'OPEN' 2* 0.216 1* 0 1* 'Z' /
 /

WCONPROD
  'P1' 'OPEN' 'ORAT' 100 4* 50 1* /
 /

GCONPROD
  'G1' 'ORAT' 150 /
 /

TSTEP
  6*5 /

END
